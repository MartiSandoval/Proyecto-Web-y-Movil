# Servidor backend
PORT=8000
NODE_ENV=development

# Base de datos (true = usar datos mock, false = usar Supabase)
USE_MOCK=false

# Supabase (cloud - requerido cuando USE_MOCK=false)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
SUPABASE_ANON_KEY=tu-anon-key-aqui

# JWT
JWT_SECRET=dev-secret-cambia-en-produccion

# CORS (en Docker el frontend es servido por Nginx en puerto 80)
CORS_ORIGIN=http://localhost:80
