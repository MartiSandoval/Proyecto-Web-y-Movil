    {
      "name": "2. Trámites",
      "item": [
        {
          "name": "TC-10 · Listar trámites (público, sin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
