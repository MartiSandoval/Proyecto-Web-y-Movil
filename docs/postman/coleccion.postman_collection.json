            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Duplicado\",\n  \"rut\": \"19876543-2\",\n  \"email\": \"juan.prueba@test.com\",\n  \"password\": \"test123\",\n  \"telefono\": \"912345678\",\n  \"region\": \"valparaiso\",\n  \"comuna\": \"santo_domingo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/registro",
