  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "TC-01 · Registro exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta contiene token\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json).to.have.property('user');",
                  "    if (json.token) pm.collectionVariables.set('token', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Prueba\",\n  \"rut\": \"19876543-2\",\n  \"email\": \"juan.prueba@test.com\",\n  \"password\": \"test123\",\n  \"telefono\": \"912345678\",\n  \"region\": \"valparaiso\",\n  \"comuna\": \"santo_domingo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/registro",
              "host": ["{{base_url}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "TC-02 · Registro con email duplicado",
          "event": [
